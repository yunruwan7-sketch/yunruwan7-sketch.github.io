{
  "schemaVersion": 1,
  "contentVersion": "train-prototype-1",
  "_说明": "首版逻辑样例；不包含图片、UI、场景美术或音频资源。用户2026-10-16修改：自由探索消耗时间。具体台词和线索为可替换草案。",
  "_字段说明": {
    "id": "稳定ID，同一类不能重复，不使用点号；存档依赖此ID。",
    "conditions": "所有条件同时满足。key=状态键；comparison=Equal/AtLeast/AtMost；value=数字；reason=缺失说明。",
    "effects": "同批原子生效。operation=Set/Add；value=数字。物品数量必须为非负整数。",
    "action": "先执行effects，再调用command/target。command支持dialogue/puzzle/comic/event/ending。",
    "stateNamespaces": "flag=剧情事实；item=实体物品数量；clue=本轮知识；recipe=配方；task=0锁定/1进行/2完成；clock.phase=0早/1午/2下午/3晚；memory=跨周目记忆。runtime/clock/puzzle/event/task/memory由对应系统维护。",
    "clock": "分钟从00:00起计算；420=07:00，1440=24:00。默认现实1秒=游戏1分钟，完整17小时约17分钟自由探索。对话、漫画、谜题、菜单暂停；夜间事件开始后冻结世界时钟。",
    "puzzles": "Sequence=顺序检查；Cipher=对照解码；Placement=三步布置；Click=独立连点。answers按槽位排列。durationSeconds单位秒；progressPerClick取(0,1]。",
    "npcBehaviours": "按配置顺序选择第一个满足条件的行为；anchorId与未来场景锚点一致，facing=-1向左/+1向右。",
    "comics": "panels是未来显示层使用的资源ID，captions与其一一对应；本阶段不加载素材。",
    "automaticEvents": "只在探索中检查，每周目触发一次；按JSON顺序确定优先级。",
    "risk": "requiresConfirmation=true时调用端必须明确传confirmed=true，不能默认确认。",
    "saving": "只有一个自动存档。关键状态立即写入；纯时钟、移动和连点计时合并保存。新周目保留memory，不保留实体道具。"
  },
